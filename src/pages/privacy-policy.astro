---
const lastUpdated = 'November 19, 2026';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="index, follow" />
		<title>Privacy Policy — Svenska Bits</title>
		<meta
			name="description"
			content="Privacy policy for the Svenska Bits iOS app."
		/>
		<style>
			:root {
				font-family: system-ui, sans-serif;
				color: #222;
				background: #fff;
				font-synthesis: none;
				text-rendering: optimizeLegibility;
			}

			body {
				max-width: 44rem;
				margin: 0 auto;
				padding: 3rem 1.25rem;
				line-height: 1.65;
			}

			a {
				color: #176b57;
			}

			@media (prefers-color-scheme: dark) {
				:root {
					color: #eee;
					background: #171717;
				}

				a {
					color: #78d7ba;
				}
			}
		</style>
	</head>
	<body>
		<main>
			<p><a href="/">Svenska Bits</a></p>
			<h1>Privacy Policy</h1>
			<p>Last updated: {lastUpdated}</p>

			<p>
				The Svenska Bits iOS app does not collect personal information. It does not
				use accounts, analytics, advertising, or tracking, and it does not access
				your location.
			</p>

			<p>
				If you contact us by email, we will use your email and message only to
				respond. We do not sell or share personal information.
			</p>

			<p>
				Questions about this policy? Contact
				<a href="mailto:mojtaba@gmail.com">mojtaba@gmail.com</a>.
			</p>
		</main>
	</body>
</html>
