---
import type { ProperNounVocabularyEntry } from '../../types/vocabulary';

interface Props {
	entry: ProperNounVocabularyEntry;
}

const { entry } = Astro.props;
---

<details class="vocabulary-card vocabulary-card--proper-noun">
	<summary class="vocabulary-card__summary">
		<span class="vocabulary-card__kind">Proper noun</span>
		<h3 lang="sv">{entry.swedish}</h3>
		<p class="vocabulary-card__phonetic" lang="sv-fonipa" aria-label={`IPA pronunciation: ${entry.phonetic}`}>
			{entry.phonetic}
		</p>
		<p class="vocabulary-card__translation">{entry.english}</p>
	</summary>
	<div class="vocabulary-card__details">
	<div class="vocabulary-card__example">
		<p lang="sv">{entry.example.swedish}</p>
		<p>{entry.example.english}</p>
	</div>
	</div>
</details>
