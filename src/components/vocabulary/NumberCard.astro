---
import type { NumberVocabularyEntry } from '../../types/vocabulary';

interface Props {
	entry: NumberVocabularyEntry;
}

const { entry } = Astro.props;
---

<article class="vocabulary-card vocabulary-card--number">
	<header class="vocabulary-card__header">
		<span class="vocabulary-card__kind">Number</span>
		<h3 lang="sv">{entry.swedish}</h3>
		<p class="vocabulary-card__phonetic" lang="sv-fonipa" aria-label={`IPA pronunciation: ${entry.phonetic}`}>
			{entry.phonetic}
		</p>
		<p class="vocabulary-card__translation">{entry.english}</p>
	</header>
	<div class="vocabulary-card__example">
		<p lang="sv">{entry.example.swedish}</p>
		<p>{entry.example.english}</p>
	</div>
</article>
