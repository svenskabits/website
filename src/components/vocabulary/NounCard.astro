---
import type { NounVocabularyEntry } from '../../types/vocabulary';

interface Props {
	entry: NounVocabularyEntry;
}

const { entry } = Astro.props;
const forms = [
	{ label: 'Indefinite singular', ...entry.forms.indefiniteSingular },
	{ label: 'Definite singular', ...entry.forms.definiteSingular },
	{ label: 'Indefinite plural', ...entry.forms.indefinitePlural },
	{ label: 'Definite plural', ...entry.forms.definitePlural },
];
---

<details class="vocabulary-card vocabulary-card--noun">
	<summary class="vocabulary-card__summary">
		<span class="vocabulary-card__kind">Noun</span>
		<h3 lang="sv">{entry.lemma}</h3>
		<p class="vocabulary-card__phonetic" lang="sv-fonipa" aria-label={`IPA pronunciation: ${entry.phonetic}`}>
			{entry.phonetic}
		</p>
		<p class="vocabulary-card__translation">{entry.translation}</p>
	</summary>
	<div class="vocabulary-card__details">
	<dl class="vocabulary-card__forms">
		{forms.map(({ label, form, phonetic, example }) => (
			<div class="vocabulary-card__noun-form">
				<div class="vocabulary-card__form">
					<dt>{label}</dt>
					<dd class="vocabulary-card__noun-form-value">
						<span lang="sv">{form}</span>
						<span class="vocabulary-card__phonetic" lang="sv-fonipa">{phonetic}</span>
					</dd>
				</div>
				<div class="vocabulary-card__form-example">
					<p lang="sv">{example.swedish}</p>
					<p>{example.english}</p>
				</div>
			</div>
		))}
	</dl>
	</div>
</details>
