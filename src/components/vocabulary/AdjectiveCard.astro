---
import { AdjectiveFormType, type AdjectiveVocabularyEntry } from '../../types/vocabulary';

interface Props {
	entry: AdjectiveVocabularyEntry;
}

const { entry } = Astro.props;
const formLabels: Record<AdjectiveFormType, string> = {
	[AdjectiveFormType.COMMON]: 'Common',
	[AdjectiveFormType.NEUTER]: 'Neuter',
	[AdjectiveFormType.PLURAL]: 'Plural',
	[AdjectiveFormType.ADVERB]: 'Adverb',
	[AdjectiveFormType.COMPARATIVE]: 'Comparative',
	[AdjectiveFormType.SUPERLATIVE]: 'Superlative',
};
---

<details class="vocabulary-card vocabulary-card--adjective">
	<summary class="vocabulary-card__summary">
		<span class="vocabulary-card__kind">Adjective</span>
		<h3 lang="sv">{entry.lemma}</h3>
		<p class="vocabulary-card__phonetic" lang="sv-fonipa" aria-label={`IPA pronunciation: ${entry.phonetic}`}>
			{entry.phonetic}
		</p>
		<p class="vocabulary-card__translation">{entry.translation}</p>
	</summary>
	<div class="vocabulary-card__details">
	<dl class="vocabulary-card__forms">
		{entry.forms.map(({ type, form, phonetic, example }) => (
			<div class="vocabulary-card__adjective-form">
				<div class="vocabulary-card__form">
					<dt>{formLabels[type]}</dt>
					<dd class="vocabulary-card__adjective-form-value">
						<span lang="sv">{form}</span>
						<span class="vocabulary-card__phonetic" lang="sv-fonipa">{phonetic}</span>
					</dd>
				</div>
				<div class="vocabulary-card__form-example">
					<p lang="sv">{example.swedish}</p>
					<p>{example.english}</p>
				</div>
			</div>
		))}
	</dl>
	</div>
</details>
