---
import type { AdjectiveVocabularyEntry } from '../../types/vocabulary';

interface Props {
	entry: AdjectiveVocabularyEntry;
}

const { entry } = Astro.props;
const forms = [
	{ label: 'Common', value: entry.forms.common },
	{ label: 'Neuter', value: entry.forms.neuter },
	{ label: 'Plural', value: entry.forms.plural },
	{ label: 'Comparative', value: entry.forms.comparative },
	{ label: 'Superlative', value: entry.forms.superlative },
	...(entry.forms.adverb ? [{ label: 'Adverb', value: entry.forms.adverb }] : []),
];
---

<article class="vocabulary-card vocabulary-card--adjective">
	<header class="vocabulary-card__header">
		<span class="vocabulary-card__kind">Adjective</span>
		<h3 lang="sv">{entry.lemma}</h3>
		<p class="vocabulary-card__translation">{entry.translation}</p>
	</header>
	<dl class="vocabulary-card__forms">
		{forms.map(({ label, value }) => (
			<div class="vocabulary-card__form">
				<dt>{label}</dt>
				<dd lang="sv">{value}</dd>
			</div>
		))}
	</dl>
	{entry.examples.length > 0 && (
		<ul class="vocabulary-card__examples">
			{entry.examples.map((example) => (
				<li>
					{example.form && <span class="vocabulary-card__example-label">{example.form}</span>}
					<p lang="sv">{example.swedish}</p>
					<p>{example.english}</p>
				</li>
			))}
		</ul>
	)}
</article>
