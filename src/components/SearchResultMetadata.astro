---
import Default from '@astrojs/starlight/components/PageTitle.astro';

const { level, type } = Astro.locals.starlightRoute.entry.data as {
	level?: string;
	type?: string;
};
---

<Default />
{level && <span data-pagefind-meta={`level:${level}`} />}
{type && <span data-pagefind-meta={`type:${type}`} />}
